rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // usernames/{username}
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // resumes/{resumeId}
    match /resumes/{resumeId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // resumes/{resumeId}/versions/{versionId}
      match /versions/{versionId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/resumes/$(resumeId)).data.userId == request.auth.uid;
      }
    }

    // analytics/{docId} — view counts, not sensitive
    match /analytics/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // customers/{userId} — written by Stripe webhook via admin SDK
    match /customers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // apiKeys/{keyId}
    match /apiKeys/{keyId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // stripeEvents/{eventId} — admin SDK only
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // rateLimits/{docId} — admin SDK only
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
